api.sims.science {
	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Timeouts & protection
	reverse_proxy localhost:8000 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
		max_fails 3
	}

	# Access logging (masked per compliance Finding 5.2)
	log {
		output file /home/agent/workspace/science-ed/caddy-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			request>remote_ip hash
			request>headers>User-Agent delete
		}
	}

	encode gzip
}

# Redirect bare sims.science to https://sims.science
sims.science {
	header {
		-Server
	}
	redir https://sims.science{uri}
}
